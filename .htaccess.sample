# =============================================================
#  株式会社On Your Mark  サーバー設定サンプル（Apache用）
#  -------------------------------------------------------------
#  このファイルを「.htaccess」にリネームして、サイトのルートに置いてください。
#  ※ エックスサーバー等の一般的な共用サーバーを想定しています。
#  ※ Nginx / Cloudflare Pages / Netlify をお使いの場合は
#     同等の設定をそれぞれの管理画面・設定ファイルで行ってください。
# =============================================================

# ---------- 常時SSL（http → https） ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # www あり／なしの統一（どちらかに寄せる。下は www を無しへ統一する例）
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # index.html への直リンクをディレクトリURLへ正規化
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# ---------- 旧サイト（WordPress）のURLからの転送 ----------
# 名刺・パンフレット・求人媒体などに旧URLを記載している場合のみ、
# 下のコメントを外して実際の対応に書き換えてください。
# 該当がなければ不要です（旧URLは404ページが出ます）。
# ※ R=301 は「恒久的な移転」。302 にすると検索評価が引き継がれません。
#<IfModule mod_rewrite.c>
#  RewriteEngine On
#  RewriteRule ^company/?$        /company.html   [R=301,L]
#  RewriteRule ^contact/?$        /contact.html   [R=301,L]
#  RewriteRule ^privacy-policy/?$ /privacy.html   [R=301,L]
#</IfModule>

# ---------- カスタム404（ステータスコード404を返すために必須） ----------
ErrorDocument 404 /404.html

# ---------- セキュリティヘッダ ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  # HSTS：httpsが安定してから有効化してください（一度有効にすると戻しにくい設定です）
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content-Security-Policy：Googleフォント／reCAPTCHA を許可した最小構成。
  # アクセス解析などを追加した場合は、そのドメインを追記してください。
  # Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com; frame-src https://www.google.com; connect-src 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ---------- 圧縮 ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ---------- キャッシュ ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/html               "access plus 10 minutes"
</IfModule>

# ---------- 文字コード ----------
AddDefaultCharset UTF-8
